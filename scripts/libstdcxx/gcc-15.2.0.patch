+#if defined(_WIN32) && _WIN32_WINNT < 0x0500
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+namespace
+{
+  // Gives the time since 1/1/1970 in nanoseconds, from
+  // GetSystemTimeAsFileTime where Windows has it (NT 3.5, 95 and later),
+  // and from GetSystemTime otherwise.
+  long long
+  __win32_system_time() noexcept
+  {
+    typedef VOID (WINAPI *__get_time_fn)(LPFILETIME);
+    static __get_time_fn __get_time = reinterpret_cast<__get_time_fn>(
+      reinterpret_cast<void*>(GetProcAddress(GetModuleHandleA("kernel32.dll"),
+					     "GetSystemTimeAsFileTime")));
+    FILETIME __ft;
+    if (__get_time)
+      __get_time(&__ft);
+    else
+      {
+	SYSTEMTIME __st;
+	GetSystemTime(&__st);
+	SystemTimeToFileTime(&__st, &__ft);
+      }
+    unsigned long long __t
+      = (static_cast<unsigned long long>(__ft.dwHighDateTime) << 32)
+	| __ft.dwLowDateTime;
+    // From 100 ns since 1/1/1601.
+    return static_cast<long long>(__t - 116444736000000000ULL) * 100;
+  }
+}
+#endif
