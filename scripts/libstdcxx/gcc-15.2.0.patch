+	typedef FILE* (__cdecl *__wfopen_fn)(const wchar_t*, const wchar_t*);
+	__wfopen_fn __wfopen = reinterpret_cast<__wfopen_fn>(
+	  reinterpret_cast<void*>(GetProcAddress(GetModuleHandleA("msvcrt.dll"),
+						 "_wfopen")));
+	if (__wfopen)
+	  return __wfopen(__name, __wc_mode);
+      }
+    int __len = WideCharToMultiByte(CP_ACP, 0, __name, -1, 0, 0, 0, 0);
+    if (__len <= 0)
+      return 0;
+    char* __aname = static_cast<char*>(__builtin_alloca(__len));
+    if (!WideCharToMultiByte(CP_ACP, 0, __name, -1, __aname, __len, 0, 0))
+      return 0;
+    return fopen(__aname, __c_mode);
+  }
